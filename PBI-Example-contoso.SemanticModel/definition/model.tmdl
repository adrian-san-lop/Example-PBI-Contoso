model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: es-ES
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

ref table CurrencyExchange
ref table Customer
ref table Date
ref table OrderRows
ref table Orders
ref table Product
ref table Sales
ref table Store
ref table Measure

ref cultureInfo en-US

